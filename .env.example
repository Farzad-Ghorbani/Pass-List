# Pass-List compose deployment settings.
# Copy this file to .env and replace every CHANGE_ME value before first start.

PASSLIST_BASE_PATH=/opt/pass-list
TZ=Asia/Tehran

# Initial hostname/IP used for the bootstrap host allow-list and temporary self-signed TLS certificate.
# Set this to the IP or DNS name you will use for the first login.
PASSLIST_INITIAL_HOSTNAME=pass-list.local
DJANGO_ALLOWED_HOSTS=pass-list.local,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=passlist_db
POSTGRES_USER=passlist_user
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET
PASSLIST_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
PASSLIST_OPS_TOKEN=CHANGE_ME_LONG_RANDOM_OPS_TOKEN

SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME_INITIAL_SUPERADMIN_PASSWORD
SUPERADMIN_EMAIL=

DJANGO_DEBUG=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
PASSLIST_IDLE_TIMEOUT_SECONDS=900
SESSION_COOKIE_AGE=1800
PASSLIST_SESSION_STORAGE_AGE=2592000
SESSION_EXPIRE_AT_BROWSER_CLOSE=true
SESSION_SAVE_EVERY_REQUEST=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
APP_NAME=Pass-List
APP_COMPANY_NAME=IT Department
